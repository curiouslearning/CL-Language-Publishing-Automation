# Copy this file to .env (same folder) and paste your keys. .env is gitignored; never commit it.
# Only the key for the provider chosen in config.json is needed.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Only if your Claude key is NOT scoped to a workspace (error: "must include the anthropic-workspace-id
# header"): the workspace ID from Claude Console > Settings > Workspaces. Leave empty otherwise.
ANTHROPIC_WORKSPACE_ID=
